{
  "fentree": {
    "prefix": "fentree",
    "body": [
      "template <class T>",
      "struct FenTree {",
      "  int n;",
      "  T *g, *f;",
      "",
      "  FenTree(const int &n) : n(n) {",
      "    g = new T[n + 1]();",
      "    f = new T[n + 1]();",
      "  }",
      "",
      "  ~FenTree() {",
      "    if (f) delete[] f;",
      "    if (g) delete[] g;",
      "  }",
      "",
      "  void reset(int _n = -1) {",
      "    if (_n != -1) n = _n;",
      "    rpt(i, 1, n + 1) {",
      "      g[i] = T();",
      "      f[i] = T();",
      "    }",
      "  }",
      "",
      "  void add(int i, const T &val) {",
      "    g[i] += val;",
      "    while (i <= n) {",
      "      f[i] += val;",
      "      i += i & -i;",
      "    }",
      "  }",
      "",
      "  T get(int r) const {",
      "    T res = T();",
      "    for (r = min(r, n); r > 0;) {",
      "      res += f[r];",
      "      r -= r & -r;",
      "    }",
      "    return res;",
      "  }",
      "",
      "  T get(int l, int r) const {",
      "    T res = T();",
      "    while (r >= l) {",
      "      int m = r - (r & -r);",
      "      if (m >= l - 1) {",
      "        res += f[r];",
      "        r = m;",
      "      } else {",
      "        res += g[r--];",
      "      }",
      "    }",
      "    return res;",
      "  }",
      "};"
    ],
    "description": "Fenwick Tree for sum indexing"
  },
  "modint": {
    "prefix": "modint",
    "body": [
      "template <const int m> struct Mint {",
      "  int v;",
      "  static_assert(m > 0);",
      "",
      "  // @constructors",
      "  Mint(int64_t value = 0) : v(value % m) {",
      "    if (v < 0)",
      "      v += m;",
      "  }",
      "",
      "  // @increments",
      "  Mint &operator++() {",
      "    if (v++; v == m)",
      "      v = 0;",
      "    return *this;",
      "  }",
      "  Mint operator++(int) {",
      "    Mint result = *this;",
      "    ++*this;",
      "    return result;",
      "  }",
      "",
      "  // @decrements",
      "  Mint &operator--() {",
      "    if (v == 0)",
      "      v = m;",
      "    v--;",
      "    return *this;",
      "  }",
      "  Mint operator--(int) {",
      "    Mint result = *this;",
      "    --*this;",
      "    return result;",
      "  }",
      "",
      "  // @sign_operators",
      "  Mint operator+() const { return *this; }",
      "  Mint operator-() const { return Mint() - *this; }",
      "",
      "  // @inverse",
      "  Mint inv() const {",
      "    int a = 1, b = 0;",
      "    for (int x = v, y = m; x != 0;)",
      "      swap(a, b -= y / x * a), swap(x, y -= y / x * x);",
      "    return b + (b < 0) * m;",
      "  }",
      "",
      "  // @self_operators",
      "  Mint &operator+=(const Mint &other) {",
      "    if (v += other.v; v >= m)",
      "      v -= m;",
      "    return *this;",
      "  }",
      "  Mint &operator-=(const Mint &other) {",
      "    if (v -= other.v; v < 0)",
      "      v += m;",
      "    return *this;",
      "  }",
      "  Mint &operator*=(const Mint &other) {",
      "    v = ll(v) * other.v % m;",
      "    return *this;",
      "  }",
      "  Mint &operator/=(const Mint &other) {",
      "    *this *= other.inv();",
      "    return *this;",
      "  }",
      "",
      "  // @comparisons",
      "  friend bool operator==(const Mint &a, const Mint &b) { return a.v == b.v; }",
      "  friend bool operator!=(const Mint &a, const Mint &b) { return a.v != b.v; }",
      "",
      "  // @friend_operators",
      "  friend Mint operator+(const Mint &a, const Mint &b) { return Mint(a) += b; }",
      "  friend Mint operator-(const Mint &a, const Mint &b) { return Mint(a) -= b; }",
      "  friend Mint operator*(const Mint &a, const Mint &b) { return Mint(a) *= b; }",
      "  friend Mint operator/(const Mint &a, const Mint &b) { return Mint(a) /= b; }",
      "",
      "  // @streaming",
      "  friend istream &operator>>(istream &in, Mint &a) {",
      "    ll v;",
      "    in >> v;",
      "    return a = v, in;",
      "  }",
      "  friend ostream &operator<<(ostream &out, const Mint &a) {",
      "    out << a.v;",
      "    return out;",
      "  }",
      "  friend void __print(Mint &x) { cerr << x; }",
      "};",
      "",
      "using mint = Mint<mod>;"
    ],
    "description": "Modular int with fast arithmetic ops"
  },
  "matrix": {
    "prefix": "matrix",
    "body": [
      "template <class T> struct Matrix {",
      "  // @attributes",
      "  int n, m;",
      "  T **elts;",
      "  T *operator[](const int &r_idx) { return elts[r_idx]; }",
      "",
      "  // @utils",
      "  void init_elts() {",
      "    elts = new T *[n];",
      "    rpt(i, 0, n) elts[i] = new T[m]();",
      "  }",
      "  void copy_elts(T **elts) {",
      "    rpt(i, 0, n) copy(elts[i], elts[i] + m, this->elts[i]);",
      "  }",
      "  void erase_elts() {",
      "    rpt(i, 0, n) delete[] elts[i];",
      "    delete[] elts;",
      "  }",
      "",
      "  // @constructors",
      "  Matrix(int n, int m) : n(n), m(m) { init_elts(); }",
      "",
      "  Matrix(const initializer_list<initializer_list<T>> &elts) {",
      "    assert((n = elts.size()) != 0);",
      "    init_elts();",
      "",
      "    int i = 0;",
      "    for (auto &row : elts) {",
      "      m = row.size();",
      "      int j = 0;",
      "      for (auto &e : row) {",
      "        this->elts[i][j] = e;",
      "        j++;",
      "      }",
      "      i++;",
      "    }",
      "  }",
      "",
      "  Matrix(int n, int m, T **elts) : n(n), m(m), elts(elts) {}",
      "",
      "  Matrix(const Matrix &other) : Matrix(other.n, other.m) {",
      "    copy_elts(other.elts);",
      "  }",
      "",
      "  Matrix(Matrix &&other) noexcept : Matrix(other.n, other.m, other.elts) {",
      "    other.elts = nullptr;",
      "  }",
      "",
      "  // @destructor",
      "  ~Matrix() {",
      "    if (elts)",
      "      erase_elts();",
      "  }",
      "",
      "  // @assignments",
      "  Matrix &operator=(const Matrix &other) {",
      "    if (this != &other) {",
      "      erase_elts();",
      "      n = other.n;",
      "      m = other.m;",
      "      init_elts();",
      "      copy_elts(other.elts);",
      "    }",
      "    return *this;",
      "  }",
      "",
      "  Matrix &operator=(Matrix &&other) noexcept {",
      "    if (this != &other) {",
      "      erase_elts();",
      "      n = other.n;",
      "      m = other.m;",
      "      elts = other.elts;",
      "      other.elts = nullptr;",
      "    }",
      "    return *this;",
      "  }",
      "",
      "  // @operators",
      "  friend Matrix<T> operator*(const Matrix &a, const Matrix<T> &b) {",
      "    assert(a.m == b.n);",
      "    Matrix c(a.n, b.m);",
      "    rpt(i, 0, a.n) rpt(j, 0, b.m) rpt(k, 0, a.m) {",
      "      c[i][j] += a.elts[i][k] * b.elts[k][j];",
      "    }",
      "    return c;",
      "  }",
      "  Matrix<T> &operator*=(const Matrix &other) {",
      "    return *this = *this * other;",
      "  }",
      "",
      "  // @debug",
      "  friend void __print(Matrix x) {",
      "    cerr << \"Matrix({\\n\";",
      "    rpt(i, 0, x.n) {",
      "      cerr << \"  { \";",
      "      rpt(j, 0, x.m) {",
      "        __print(x.elts[i][j]);",
      "        if (j != x.m - 1)",
      "          cerr << \", \";",
      "      }",
      "      cerr << (i == x.n - 1 ? \" }\\n\" : \" },\\n\");",
      "    }",
      "    cerr << \"})\";",
      "  }",
      "};"
    ],
    "description": "2D implementation of Matrix"
  },
  "convexhull": {
    "prefix": "convexhull",
    "body": [
      "template <class T> struct ConvexHullTrick {",
      "  using Line = pair<T, T>;",
      "",
      "  bool lower_hull;",
      "  ConvexHullTrick(bool lower_hull = true) : lower_hull(lower_hull) {}",
      "",
      "  int n = 0; // number of lines",
      "  vector<Line> lines;",
      "  vector<ld> breakpts;",
      "",
      "  void reset() {",
      "    n = 0;",
      "    lines.clear();",
      "    breakpts.clear();",
      "  }",
      "",
      "  ld intersectX(const Line &u, const Line &v) {",
      "    const auto &[a1, b1] = u;",
      "    const auto &[a2, b2] = v;",
      "    return ld(b2 - b1) / (a1 - a2);",
      "  }",
      "",
      "  void addLine(Line u) {",
      "    if (!lines.empty() && lines[n - 1].fi == u.fi) {",
      "      // If slopes are equal, keep the",
      "      // better line (depends on lower/upper hull).",
      "      if (u.se == lines[n - 1].se)",
      "        return;",
      "      if (lower_hull ^ (lines[n - 1].se > u.se))",
      "        return;",
      "      lines.pop_back();",
      "      if (!breakpts.empty())",
      "        breakpts.pop_back();",
      "      n--;",
      "    }",
      "",
      "    if (!lines.empty()) {",
      "      while (n >= 2) {",
      "        ld x = intersectX(u, lines[n - 2]);",
      "        if (x >= breakpts[n - 2])",
      "          break;",
      "        n--;",
      "        lines.pop_back();",
      "        breakpts.pop_back();",
      "      }",
      "      breakpts.push_back(intersectX(u, lines[n - 1]));",
      "    }",
      "    n++;",
      "    lines.push_back(u);",
      "  }",
      "",
      "  T query(const T &x) {",
      "    assert(!lines.empty());",
      "    auto itr = upper_bound(breakpts.begin(), breakpts.end(), x);",
      "    Line u = lines[itr - breakpts.begin()];",
      "    return u.fi * x + u.se;",
      "  }",
      "};"
    ],
    "description": "Simple Convex Hull Trick for line queries"
  },
  "trienode": {
    "prefix": "trie",
    "body": [
      "struct TrieNode {",
      "  int val;",
      "  TrieNode *nxt[2];",
      "",
      "  TrieNode() : val(0) {",
      "    nxt[0] = nullptr;",
      "    nxt[1] = nullptr;",
      "  }",
      "",
      "  bool has(const int &u) { return nxt[u] != nullptr; }",
      "",
      "  TrieNode *push(const int &u) {",
      "    if (!has(u)) {",
      "      nxt[u] = new TrieNode();",
      "    }",
      "    nxt[u]->val++;",
      "    return nxt[u];",
      "  }",
      "};"
    ],
    "description": "Trie implementation with pointer"
  },
  "combinatorics": {
    "prefix": "combinatorics",
    "body": [
      "namespace combi {",
      "  const int N = 1e6 + 5;",
      "",
      "  mint f[N];",
      "",
      "  void preprocess() {",
      "    f[0] = 1;",
      "    rpt(i, 1, N) f[i] = f[i - 1] * i;",
      "  }",
      "",
      "  mint nAk(int n, int k) { return f[n] / f[n - k]; }",
      "  mint nCk(int n, int k) { return nAk(n, k) / f[k]; }",
      "}  // namespace combi"
    ],
    "description": "Basic combinatorics operations"
  },
  "fentree_bound": {
    "prefix": "fentree_bound",
    "body": [
      "pair<int, T> upper_bound(T val) const {",
      "  int i = 0, h = __lg(n);",
      "  T tot = T();",
      "  tpr(k, h + 1, 0) {",
      "    int j = i + (1 << k);",
      "    if (j > n) continue;",
      "    if (tot + f[j] <= val) {",
      "      tot += f[i = j];",
      "    }",
      "  }",
      "  return {i + 1, tot + (i < n ? g[i + 1] : 0)};",
      "}",
      "",
      "pair<int, T> lower_bound(T val) const { return upper_bound(val - 1); }"
    ],
    "description": "lower_bound & upper_bound on Fenwick Tree"
  },
  "compressor": {
    "prefix": "compressor",
    "body": [
      "template <class T>",
      "struct Compressor {",
      "  vector<T> q;",
      "  map<T, int> mp;",
      " ",
      "  Compressor() : q(1) {}",
      " ",
      "  void add(T x) { q.push_back(x); }",
      "  void compress() {",
      "    sort(q.begin() + 1, q.end());",
      "    q.erase(unique(q.begin() + 1, q.end()), q.end());",
      "    rpt(i, 1, q.size()) mp[q[i]] = i;",
      "  }",
      " ",
      "  T &inv(const int &x) { return q[x]; }",
      "  int size() const { return q.size() - 1; }",
      "  int operator[](const T &x) { return mp[x]; }",
      "  bool has(const T &x) const { return mp.count(x); }",
      "};"
    ],
    "description": "1-index bi-directional numerical compressor"
  },
  "lazy_segtree": {
    "prefix": "lazy_segtree",
    "body": [
      "template <class T>",
      "struct SegTree {",
      "  int n, *lz;",
      "  T *t;",
      "",
      "  SegTree(int n) : n(n), t(new T[2 * n]), lz(new int[n]) {}",
      "",
      "  ~SegTree() {",
      "    delete[] t;",
      "    delete[] lz;",
      "  }",
      "",
      "  T &operator[](const int &idx) { return t[idx]; }",
      "",
      "  T &merge(const int &i) {",
      "    t[i] = min(t[i << 1], t[i << 1 | 1]);",
      "    return t[i] += lz[i];",
      "  }",
      "",
      "  void apply(const int &u, const T &val) {",
      "    t[u] += val;",
      "    if (u < n) lz[u] += val;",
      "  }",
      "",
      "  void push(const int &u) {",
      "    int h = __lg(n);",
      "    tpr(j, h + 1, 1) {",
      "      int i = u >> j;",
      "      if (i > 0 && lz[i] != 0) {",
      "        apply(i << 1, lz[i]);",
      "        apply(i << 1 | 1, lz[i]);",
      "        lz[i] = 0;",
      "      }",
      "    }",
      "  }",
      "",
      "  void build(int p) {",
      "    while ((p >>= 1) > 0) merge(p);",
      "  }",
      "",
      "  void add(int l, int r, const T &val) {",
      "    int l0 = l += n;",
      "    int r0 = r += n;",
      "    for (r++; l < r; l >>= 1, r >>= 1) {",
      "      if (l & 1) apply(l++, val);",
      "      if (r & 1) apply(--r, val);",
      "    }",
      "    build(l0);",
      "    build(r0);",
      "  }",
      "",
      "  T get(int l, int r) const {",
      "    push(l += n);",
      "    push(r += n);",
      "",
      "    T res = t[l];",
      "    for (r++; l < r; l >>= 1, r >>= 1) {",
      "      if (l & 1) res = min(res, t[l++]);",
      "      if (r & 1) res = min(res, t[--r]);",
      "    }",
      "    return res;",
      "  }",
      "};"
    ],
    "description": "Segment Tree that supports interval queries/updates"
  },
  "timer": {
    "prefix": "timer",
    "body": [
      "template <class DT = chrono::milliseconds,",
      "          class ClockT = chrono::steady_clock>",
      "class Timer {",
      "  using timep_t = typename ClockT::time_point;",
      "  timep_t _start = ClockT::now(), _end = {};",
      "",
      " public:",
      "  void tick() {",
      "    _end = timep_t{};",
      "    _start = ClockT::now();",
      "  }",
      "",
      "  void tock() { _end = ClockT::now(); }",
      "",
      "  template <class T = DT>",
      "  auto duration() const {",
      "    return chrono::duration_cast<T>(_end - _start);",
      "  }",
      "};"
    ],
    "description": "Benchmarking code execution time"
  }
}
